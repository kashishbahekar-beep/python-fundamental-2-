#write a program to print all the number from 1 to 100 that are divisble by both 3 and 5 
#there are two two loop for this
#while loop 
i = 1
while (i <= 100):
    if (i % 3 == 0 and i % 5 == 0):
        print(i)
    i += 1
#for loop 

for i in range(1 , 100):
    if (i % 3 == 0 and i % 5 == 0):
        print(i)              